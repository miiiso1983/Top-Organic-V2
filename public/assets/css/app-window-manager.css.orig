/* Generic app window manager styles */
#app-window-layer { position: fixed; inset: 0; z-index: 3000; pointer-events: none; }
#app-window-layer > .app-window { pointer-events: auto; }

.app-window { display: none; position: fixed; inset: 0; z-index: 3000; }
.app-window.active { display: block; }
.app-window-backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.62); backdrop-filter: blur(2px); }
.app-window-dialog { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 92%; max-width: 1300px; height: 88%; background: var(--surface); border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,.35); display: flex; flex-direction: column; overflow: hidden; border-top: 4px solid var(--brand); }
.app-window.maximized .app-window-dialog { width: 100%; height: 100%; max-width: none; top: 0; left: 0; transform: none; border-radius: 0; }

.app-window-header { padding: 12px 18px; background: linear-gradient(135deg, var(--sidebar-hover), var(--sidebar-bg)); color: #fff; border-bottom: 1px solid rgba(255,255,255,.2); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
.app-window-header h4 { margin: 0; color: #fff; font-size: 16px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.app-window-controls { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }
.app-window-controls .btn { background: rgba(255,255,255,.2) !important; color: #fff !important; border: 1px solid rgba(255,255,255,.35) !important; }
.app-window-controls .btn:hover { background: rgba(255,255,255,.35) !important; color: #fff !important; }
.app-window-controls .btn-danger { background: rgba(220,38,38,.9) !important; border-color: rgba(220,38,38,.5) !important; }

.app-window-body { flex: 1; min-height: 0; overflow: hidden; background: var(--bg); }
.app-window-body iframe { width: 100%; height: 100%; border: 0; display: block; background: var(--bg); }

.app-window-taskbar { display: none; position: fixed; z-index: 3100; right: 16px; bottom: 16px; left: 16px; min-height: 52px; padding: 8px; gap: 8px; align-items: center; background: rgba(27, 94, 32, 0.96); border: 1px solid rgba(255,255,255,.25); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.25); direction: rtl; }
.app-window-taskbar.visible { display: flex; }

/* Push page content up when the taskbar is visible so it does not overlap buttons/forms */
body.app-taskbar-visible .app .content { padding-bottom: 110px; }
.app-taskbar-label { color: #fff; font-size: 12px; font-weight: 600; padding: 0 8px; white-space: nowrap; }
.app-taskbar-items { display: flex; flex: 1; min-width: 0; gap: 8px; overflow-x: auto; }
.app-taskbar-item { display: inline-flex; align-items: center; gap: 7px; min-width: 150px; max-width: 240px; padding: 8px 10px; border: 1px solid rgba(255,255,255,.28); border-radius: 8px; background: rgba(255,255,255,.14); color: #fff; cursor: pointer; font: inherit; text-align: right; }
.app-taskbar-item:hover, .app-taskbar-item.active { background: rgba(255,255,255,.28); }
.app-taskbar-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.app-taskbar-item .taskbar-close { margin-right: auto; padding: 0 3px; border: 0; background: transparent; color: #fff; cursor: pointer; }

.app-window.maximized .app-window-maximize .fa-expand { display: none; }
.app-window:not(.maximized) .app-window-maximize .fa-compress { display: none; }

@media (max-width: 768px) {
  .app-window-dialog { width: 100%; height: 100%; top: 0; left: 0; transform: none; border-radius: 0; }
  .app-window-taskbar { right: 8px; bottom: 8px; left: 8px; }
  .app-taskbar-label { display: none; }
}
